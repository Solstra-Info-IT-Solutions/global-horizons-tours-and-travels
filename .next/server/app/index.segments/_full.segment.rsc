23:["$","section",null,{"className":"py-16 sm:py-24 bg-[#faf8f5] border-t border-slate-200","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","div",null,{"className":"text-center max-w-3xl mx-auto mb-12","children":[["$","span",null,{"className":"text-xs font-bold tracking-widest text-[#b8860b] uppercase","children":"Got Questions?"}],["$","h2",null,{"className":"font-serif text-3xl sm:text-4xl font-bold text-[#0b132b] mt-2 mb-4","children":"Frequently Asked Questions"}],["$","div",null,{"className":"w-16 h-1 bg-[#d4af37] mx-auto rounded-full mb-4"}],["$","p",null,{"className":"text-slate-600 text-sm sm:text-base leading-relaxed","children":"Everything you need to know about our private transportation, tour itineraries, customized quotes, and booking process."}]]}],["$","$L69",null,{"items":[{"id":"faq-1","question":"How can I book a tour or request a quotation?","answer":"You can easily request a quotation by filling out our online Enquiry Form, sending us a message directly on WhatsApp, or giving us a call. Since every trip is customized to your group size, travel dates, and vehicle preference, our team will review your requirements and provide a transparent customized quote promptly.","category":"booking"},{"id":"faq-2","question":"Do you provide customized travel packages?","answer":"Yes, customized trips are one of our core specialties. We tailor itineraries based on your exact travel dates, destinations of interest, group size, pacing preference, and budget.","category":"tours"},{"id":"faq-3","question":"Do you provide airport pickup and drop services?","answer":"Yes! We offer 24/7 private airport transfer services between Chhatrapati Sambhajinagar (Aurangabad) Airport (IXU) / nearby transit hubs and your hotel or destination. Our driver tracks your arrival status for seamless pickups.","category":"transport"},{"id":"faq-4","question":"Do you provide private transportation and taxi services?","answer":"Yes, private transportation is a primary part of our business. We provide dedicated chauffeur-driven vehicles for local city travel, heritage sightseeing, intercity transit, and multi-day outstation journeys across Maharashtra.","category":"transport"},{"id":"faq-5","question":"Can you arrange Ajanta and Ellora cave tours?","answer":"Absolutely. Ajanta Caves and Ellora Caves are our most requested heritage routes. We arrange private transportation, optimal day-wise schedules, driver assistance, and route advice so you can explore both UNESCO sites comfortably.","category":"tours"},{"id":"faq-6","question":"Can I customize my itinerary after contacting you?","answer":"Yes. Before finalizing your booking, we discuss your travel preferences in detail. You can freely adjust start times, monument stops, lunch breaks, and additional visits (such as Daulatabad Fort or local handloom weaving centers).","category":"tours"},{"id":"faq-7","question":"How is the package or trip price calculated?","answer":"Our pricing is transparent and calculated based on your specific requirements: travel dates, chosen vehicle category, total duration/kilometer coverage, tolls, parking, and driver allowances. This ensures you only pay for what you actually need.","category":"booking"},{"id":"faq-8","question":"What information do you need to send me a quotation?","answer":"To give you an accurate quotation, please share: (1) Your travel dates, (2) Number of travelers, (3) Pickup location and destination(s), (4) Type of trip (e.g., Sightseeing, Airport transfer, Outstation), and (5) Any special vehicle or accommodation preferences.","category":"booking"},{"id":"faq-9","question":"Do you provide accommodation assistance?","answer":"While our core business focuses on private transportation and guided sightseeing assistance, we can provide helpful hotel recommendations and accommodation guidance in Chhatrapati Sambhajinagar, Shirdi, and other destinations based on your preferences.","category":"general"},{"id":"faq-10","question":"Do you support foreign tourists visiting India?","answer":"Yes! We specialize in assisting international travelers visiting Maharashtra. We provide courteous driver assistance, flight arrival tracking, airport pickups, foreign exchange guidance, and dedicated support to ensure a safe, comfortable stay.","category":"general"},{"id":"faq-11","question":"Do you provide corporate transportation for companies?","answer":"Yes, we serve corporate clients, business executives, managers, and visiting officers with executive airport transfers, industrial visits, intercity corporate travel, and event transportation. GST billing support is available.","category":"transport"},{"id":"faq-12","question":"How early should I contact you before my trip?","answer":"We recommend contacting us at least 3 to 7 days in advance—especially during peak tourism season (October to March) or long holiday weekends—to secure your preferred vehicle and schedule. However, we also endeavor to assist last-minute enquiries whenever possible.","category":"booking"},{"id":"faq-13","question":"Can I enquire and plan my trip directly through WhatsApp?","answer":"Yes! WhatsApp is our most convenient and direct communication channel. You can click any 'WhatsApp Us' button on our website to start a chat with our team immediately.","category":"booking"},{"id":"faq-14","question":"What destinations do you cover across Maharashtra?","answer":"We cover all major destinations including Ajanta Caves, Ellora Caves, Bibi Ka Maqbara, Daulatabad Fort, Shirdi, Chhatrapati Sambhajinagar, Pune, Nashik, Mumbai, Mahabaleshwar, Konkan coastal points, and custom destinations across India.","category":"general"}]}]]}]}]
