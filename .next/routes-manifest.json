      "routeKeys": {},
      "namedRegex": "^/customized\\-trips(?:/)?$"
    },
    {
      "page": "/destinations",
      "regex": "^/destinations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/destinations(?:/)?$"
    },
    {
      "page": "/enquiry",
      "regex": "^/enquiry(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/enquiry(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
